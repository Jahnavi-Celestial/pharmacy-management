{
  "inputs": [
    {
      "id": "GITHUB_PERSONAL_ACCESS_TOKEN",
      "type": "promptString",
      "description": "GitHub Personal Access Token",
      "password": true
    }
  ],
  "servers": {
    "my-github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${input:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
